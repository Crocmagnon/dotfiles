{{- /*
  Régénère ~/.config/chezmoi/chezmoi.toml à chaque `chezmoi init`. Les réponses et les clés déjà
  présentes sont reprises : work n'est demandé qu'une fois (promptBoolOnce), et sourceDir et
  local_git_crypt sont recopiés s'ils existent.
  headless se déduit du type de machine (hostnamectl chassis : vm, server, container), au premier
  init seulement : la valeur enregistrée prime ensuite, et se corrige à la main dans chezmoi.toml.
  Sans systemd, il est demandé.
*/ -}}
{{- $work := promptBoolOnce . "work" "Machine du travail" -}}
{{- $headless := false -}}
{{- if hasKey . "headless" -}}
{{-   $headless = .headless -}}
{{- else if and (lookPath "hostnamectl") (stat "/run/systemd/system") -}}
{{-   $headless = has (output "hostnamectl" "chassis" | trim) (list "vm" "server" "container") -}}
{{- else -}}
{{-   $headless = promptBool "Machine sans bureau (serveur)" -}}
{{- end -}}
# git-crypt chiffre les fichiers encrypted_* ; chezmoi garde l'attribut sans rien (dé)chiffrer.
encryption = "transparent"
{{- if ne .chezmoi.sourceDir (joinPath .chezmoi.homeDir ".local/share/chezmoi") }}
sourceDir = {{ .chezmoi.sourceDir | quote }}
{{- end }}

[data]
work = {{ $work }}
headless = {{ $headless }}
{{- range $key := list "local_git_crypt" }}
{{- if hasKey $ $key }}
{{ $key }} = {{ get $ $key | toJson }}
{{- end }}
{{- end }}
{{- if and (not $work) (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") }}

# Réponses de l'API GitHub gardées une semaine : .chezmoiexternal.toml demande la dernière release de
# kwin4_effect_geometry_change à chaque commande, et chezmoi échouerait hors ligne au-delà d'une minute (défaut).
[github]
refreshPeriod = "168h"
{{- end }}
