#!/bin/sh
# Réglages Plasma de .chezmoidata/plasma.yaml, rejoués à chaque connexion avant KWin
# (plasma-settings.service) et par run_onchange_after_plasma.sh quand ils changent.
# kglobalaccel (dans KWin) lit les raccourcis au démarrage et réécrit tout le fichier à la
# déconnexion depuis sa mémoire : un raccourci écrit pendant la session était perdu (01/11/2026).
# Plasma 6 : --notify recharge à chaud les applications qui surveillent leur config ; Plasma 5
# (kwriteconfig5) ne le connaît pas.
# Chemins de kwriteconfig, pour que le script change dès qu'il est installé :
# {{ lookPath "kwriteconfig6" }} {{ lookPath "kwriteconfig5" }}
if command -v kwriteconfig6 >/dev/null; then
    kw="kwriteconfig6 --notify"
elif command -v kwriteconfig5 >/dev/null; then
    kw=kwriteconfig5
else
    exit 0
fi
{{- /* Laptop sous Arch : arch-config y a mis le swapfile d'hibernation (hostnamectl chassis). */}}
{{ $archLaptop := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") (stat "/run/systemd/system") (eq (output "hostnamectl" "chassis" | trim) "laptop") -}}
{{- /* arch_desktop : bureaux Arch perso (Plasma 6, Krohnkite 0.9+, YubiKey) ; work_desktop : laptop du
     bureau (Plasma 5, Krohnkite 0.8.1). Une valeur à plusieurs touches les sépare par une tabulation : quote
     l'écrit \t, que $tab rend en vraie tabulation ; de même \n et $nl pour une valeur à plusieurs lignes. */ -}}
{{ $archDesktop := and (not (get . "work")) (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
{{ $workDesktop := get . "work" -}}
tab=$(printf '\t')
nl=$(printf '\nx'); nl=${nl%x}
# temporaire : retire les raccourcis de Karousel, qui gardent les touches de Krohnkite ; à supprimer une
# fois chaque machine passée par une connexion (kglobalaccel ne les réécrit plus ensuite).
sed -i '/^karousel-/d' "${XDG_CONFIG_HOME:-$HOME/.config}/kglobalshortcutsrc" 2>/dev/null

{{ range .plasma -}}
{{ $hosts := get . "hosts" -}}
{{ if and (or (not $hosts) (has $.chezmoi.hostname $hosts)) (or (not (get . "arch_laptop")) $archLaptop) (or (not (get . "arch_desktop")) $archDesktop) (or (not (get . "work_desktop")) $workDesktop) -}}
$kw --file {{ .file | quote }}{{ range .groups }} --group {{ . | quote }}{{ end }} --key {{ .key | quote }}{{ with get . "type" }} --type {{ . }}{{ end }} {{ .value | replace "~" $.chezmoi.homeDir | quote | replace "\\t" "${tab}" | replace "\\n" "${nl}" }}
{{ end -}}
{{ end -}}
# Mod+V ouvre le presse-papiers de la zone de notification, placé par Plasma contre la barre, plutôt que
# le menu de Klipper sous le curseur (show-on-mouse-pos, libéré dans plasma.yaml). Le raccourci d'une
# applet vit dans sa config, sous un numéro propre à chaque machine : le chercher.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
clip=$(awk -F'[][]' '/^\[Containments\]\[[0-9]+\]\[Applets\]\[[0-9]+\]$/ {g = $0; c = $4; a = $8; next}
    /^\[/ {g = ""} g != "" && $0 == "plugin=org.kde.plasma.clipboard" {print c " " a; exit}' "$conf" 2>/dev/null)
if [ -n "$clip" ]; then
    set -- $clip
    $kw --file plasma-org.kde.plasma.desktop-appletsrc --group Containments --group "$1" --group Applets \
        --group "$2" --group Shortcuts --key global "Meta+V"
    $kw --file kglobalshortcutsrc --group plasmashell --key "activate widget $2" "Meta+V,,"
fi
