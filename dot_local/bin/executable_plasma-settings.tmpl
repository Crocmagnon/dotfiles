#!/bin/sh
# Réglages Plasma de .chezmoidata/plasma.yaml, rejoués à chaque connexion avant KWin
# (plasma-settings.service) et par run_onchange_after_plasma.sh quand ils changent.
# kglobalaccel (dans KWin) lit les raccourcis au démarrage et réécrit tout le fichier à la
# déconnexion depuis sa mémoire : un raccourci écrit pendant la session était perdu (01/11/2026).
# Plasma 6 : --notify recharge à chaud les applications qui surveillent leur config ; Plasma 5
# (kwriteconfig5) ne le connaît pas.
# Chemins de kwriteconfig, pour que le script change dès qu'il est installé :
# {{ lookPath "kwriteconfig6" }} {{ lookPath "kwriteconfig5" }}
if command -v kwriteconfig6 >/dev/null; then
    kw="kwriteconfig6 --notify"
elif command -v kwriteconfig5 >/dev/null; then
    kw=kwriteconfig5
else
    exit 0
fi
{{- /* Laptop sous Arch : arch-config y a mis le swapfile d'hibernation (hostnamectl chassis). */}}
{{ $archLaptop := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") (stat "/run/systemd/system") (eq (output "hostnamectl" "chassis" | trim) "laptop") -}}
{{- /* arch_desktop : bureaux Arch perso (Karousel v0.18+, YubiKey) ; work_desktop : laptop du bureau
     (Karousel v0.7.2, Plasma 5). Une valeur à plusieurs touches les sépare par une tabulation : quote
     l'écrit \t, que $tab rend en vraie tabulation. */ -}}
{{ $archDesktop := and (not (get . "work")) (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
{{ $workDesktop := get . "work" -}}
tab=$(printf '\t')
{{ range .plasma -}}
{{ $hosts := get . "hosts" -}}
{{ if and (or (not $hosts) (has $.chezmoi.hostname $hosts)) (or (not (get . "arch_laptop")) $archLaptop) (or (not (get . "arch_desktop")) $archDesktop) (or (not (get . "work_desktop")) $workDesktop) -}}
$kw --file {{ .file | quote }}{{ range .groups }} --group {{ . | quote }}{{ end }} --key {{ .key | quote }}{{ with get . "type" }} --type {{ . }}{{ end }} {{ .value | replace "~" $.chezmoi.homeDir | quote | replace "\\t" "${tab}" }}
{{ end -}}
{{ end -}}
