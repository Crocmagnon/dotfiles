{{- if not (get . "headless") -}}
#!/bin/sh
# Rejoue les réglages Plasma quand ils changent (empreinte de ~/.local/bin/plasma-settings) :
# {{ includeTemplate "dot_local/bin/executable_plasma-settings.tmpl" . | sha256sum }}
# Les raccourcis ne prennent effet qu'à la prochaine connexion (plasma-settings.service).
# Fait connaître plasma-settings.service au gestionnaire utilisateur dès maintenant.
systemctl --user daemon-reload 2>/dev/null || true
exec "$HOME/.local/bin/plasma-settings"
{{ end -}}
