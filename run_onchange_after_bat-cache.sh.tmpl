#!/bin/sh
# bat ne voit les thèmes de ~/.config/bat/themes qu'après reconstruction de son cache.
# Hash des thèmes : {{ include "dot_config/bat/themes/Catppuccin Latte.tmTheme" | sha256sum }} {{ include "dot_config/bat/themes/Catppuccin Mocha.tmTheme" | sha256sum }}
# Sans bat (pas encore installé par mise), rien à faire : mise reconstruit le cache à
# l'installation de bat (postinstall, dans mise/config.toml).
command -v bat >/dev/null || exit 0
bat cache --build >/dev/null
