use-agent

{{/* Clé de signature par défaut choisie par le nom, sur toutes les machines : sinon gpg (≥ 2.3) prend
celle de la carte à puce présente, la YubiKey du bureau branchée derrière le KVM. Chaque machine
n'a qu'une clé secrète à ce nom. Le serveur de clés est celui de l'entreprise : travail seulement. */ -}}
{{ if get . "work" -}}
keyserver {{ include ".secrets/encrypted_gpg_keyserver" | trim }}
{{ end -}}
default-key Gabriel Augendre
{{- if get . "headless" }}
# Sans écran, pinentry-curses s'affichait sur le terminal d'un autre pane : gpg demande la
# passphrase lui-même, dans le sien, et échoue aussitôt s'il n'en a pas.
pinentry-mode loopback
{{- end }}
