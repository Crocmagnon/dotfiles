{{- if get . "headless" -}}
# Sans écran, pas d'agent SSH (ssh-agent, voir config.fish), et gpg ne passe plus par pinentry :
# gpg.conf lui fait demander la passphrase dans son propre terminal (pinentry-mode loopback).
default-cache-ttl 34560000
max-cache-ttl 34560000
{{- else -}}
enable-ssh-support
{{- if get . "work" }}
default-cache-ttl 600
max-cache-ttl 7200
default-cache-ttl-ssh 600
max-cache-ttl-ssh 7200
{{- else }}
default-cache-ttl 86400
max-cache-ttl 604800
default-cache-ttl-ssh 86400
max-cache-ttl-ssh 604800
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") }}
# Enregistre la passphrase dans KWallet (Secret Service) : ouvert à l'autologin, il déverrouille
# ainsi clés GPG et SSH (PINENTRY_KDE_USE_WALLET, dans environment.d).
pinentry-program /usr/bin/pinentry-qt
{{- end }}
{{- end }}
{{- end }}
