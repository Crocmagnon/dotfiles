{{- $work := get . "work" -}}
{
  "env": {
{{- if $work }}
    "ANTHROPIC_BASE_URL": "{{ include ".secrets/encrypted_anthropic_base_url" | trim }}",
    "ANTHROPIC_CUSTOM_HEADERS": "x-bf-lh-userid: {{ include ".secrets/encrypted_corp_email" | trim }}",
{{- end }}
    "FORCE_HYPERLINK": "1"
  },
  "permissions": {
    "deny": [
{{- if not $work }}
      "Bash(curl:*)",
      "Bash(wget:*)",
{{- end }}
      "Read(**/*.enc)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.terraformrc)",
      "Read(**/credentials.json)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Read(**/secrets.json)",
      "Read(**/terraform.rc)",
      "Read(*.tfstate)",
      "Read(*.tfvars)",
      "Read(./.env)",
      "Read(**/vault.yml)",
      "Read(**/vault.yaml)",
      "Read(./mise.local.toml)",
      "Read(./secrets/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:openlegi": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "auto-mode-setup": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '{{ .chezmoi.homeDir }}/.claude/hooks/memory-guard.py'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
{{- if $work }}
    "crit@crit": false,
{{- end }}
    "ponytail@ponytail": true,
    "modern-go-guidelines@goland-claude-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "frontend-design@anthropic-plugin-directory": true,
    "code-review@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
{{- if $work }}
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
{{- end }}
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "goland-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "JetBrains/go-modern-guidelines"
      }
    }
  },
{{- if not $work }}
  "language": "french",
{{- end }}
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "theme": "auto",
  "skipAutoPermissionPrompt": true
}
