{{- if get . "work" }}
set -gx GITHUB_TOKEN {{ include ".secrets/encrypted_github_token" | trim }}
{{- else }}
# Token GitHub en lecture seule (dépôts publics) : sans lui, mise tape l'API en anonyme et finit en
# 403. GITHUB_API_TOKEN et non GITHUB_TOKEN, que gh préférerait à son trousseau.
set -gx GITHUB_API_TOKEN {{ include ".secrets/encrypted_ro_github_token" | trim }}
{{- end }}
