[settings]
experimental = true
legacy_version_file = false
{{- if get . "local_git_crypt" }}
disable_tools = ["aqua:AGWA/git-crypt"]
{{- end }}

[tools]
usage = "latest"
terraform = "latest"
chezmoi = "latest"
eza = "latest"
bitwarden = "latest"
fzf = "latest"
node = "latest"
uv = "latest"
bat = "latest"
fd = "latest"
glow = "latest"
herdr = "latest"
marksman = "latest"
prek = "latest"
gh = "latest"
starship = "latest"
"aqua:go-delve/delve" = "latest"
go = "latest"
"go:golang.org/x/tools/gopls" = "latest"
"go:golang.org/x/tools/cmd/goimports" = "latest"
golangci-lint = "latest"
golangci-lint-langserver = "latest"
helix = "latest"
zoxide = "latest"
"aqua:AGWA/git-crypt" = "latest"
{{- if get . "work" }}
# Travail
kubectl = "latest"
go-jsonnet = "latest"
cosign = "latest"
"go:github.com/git-town/git-town/v24" = "latest"
kubectx = "latest"
jfrog-cli = "latest"
k9s = "latest"
"github:getgaal/gaal" = "latest"
stern = "latest"
{{- else }}
# Perso : outils qui venaient de Home Manager (luarocks, luacheck et busted, absents de mise, sont
# fournis par pacman sur Arch).
rust = "latest"
cargo-binstall = "latest"
"cargo:cargo-watch" = "latest"
luajit = "latest"
stylua = "latest"
lua-language-server = "latest"
terraform-ls = "latest"
{{- end }}
