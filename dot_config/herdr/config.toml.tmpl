onboarding = false

# herdr relaie la couleur de fond de kitty (OSC 2031) aux panes : il suit le clair/sombre.
[theme]
auto_switch = true
dark_name = "catppuccin-mocha"
light_name = "catppuccin-latte"

[ui]
agent_panel_sort = "priority"
show_agent_labels_on_pane_borders = true
mouse_capture = true
# Pas de demande de nom à la création d'un tab : herdr le nomme lui-même.
prompt_new_tab_name = false

[ui.toast]
delivery = "system"

[terminal]
default_shell = "{{ lookPath "fish" }}"
