{{- if not (get . "work") -}}
#!/bin/sh
# Serveurs MCP Home Assistant pour Claude Code (perso). Depuis le 2026-11-12, chaque instance HA a
# son serveur déclaré dans le .mcp.json de son dossier pCloud, et seulement là :
#   ~/pCloudSync/Home Assistant          -> home-assistant (HA de Gabriel)
#   ~/pCloudSync/Home Assistant parents  -> ha-parents (HA des parents)
# pour qu'une session ne puisse pas viser la mauvaise maison. Ce script retire donc l'ancienne
# déclaration de portée utilisateur, qui rendait le HA de Gabriel joignable partout. Les jetons
# restent dans ~/.config/ha-mcp/ (token, token-parents), gérés par chezmoi, jamais dans un .json.
# Relancé si ce script change.
# Chemin de claude, pour que le script repasse dès qu'il est installé : {{ lookPath "claude" }}
command -v claude >/dev/null || exit 0
claude mcp remove --scope user home-assistant >/dev/null 2>&1 || true
{{ end -}}
