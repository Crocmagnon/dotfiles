Include host.config
{{- if not (get . "work") }}

Host srv-1
    User gaugendre
    ControlMaster auto
    ControlPath ~/.ssh/control-%C
    ControlPersist 4h

Host hass
    HostName 192.168.0.9
    User root
    Port 32690
{{- end }}

Host *
    AddKeysToAgent yes
    {{- if not (get . "work") }}
    # Ne propose que la clé de la machine : l'agent (gpg-agent) expose aussi celle de la YubiKey
    # du bureau, branchée derrière le KVM. Avec un agent, le .pub suffit.
    IdentityFile ~/.ssh/id_ed25519.pub
    IdentitiesOnly yes
    {{- end }}
    SendEnv LANG
